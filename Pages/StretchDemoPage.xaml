<Page
    x:Class="WPF_Image.Pages.StretchDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_Image.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Stretch属性演示"
    d:DesignHeight="450"
    d:DesignWidth="600"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Margin="0,0,0,20"
            FontSize="20"
            FontWeight="Bold"
            Text="Stretch属性演示" />

        <!--  主内容  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!--  Stretch属性说明  -->
                <GroupBox Margin="0,0,0,20" Header="Stretch属性说明">
                    <StackPanel Margin="10">
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            Stretch属性决定了图像如何适应其容器空间。WPF提供了四种不同的拉伸方式，分别是None、Fill、Uniform和UniformToFill。
                        </TextBlock>

                        <TextBlock Margin="0,10,0,5" FontWeight="SemiBold">Stretch属性可选值:</TextBlock>
                        <TextBlock Margin="20,0,0,5" Text="• None: 保持原始尺寸" />
                        <TextBlock Margin="20,0,0,5" Text="• Fill: 拉伸以填充整个空间（可能导致图像变形）" />
                        <TextBlock Margin="20,0,0,5" Text="• Uniform: 等比例拉伸，确保整个图像可见（可能有空白）" />
                        <TextBlock Margin="20,0,0,5" Text="• UniformToFill: 等比例拉伸，填满空间（可能裁剪部分图像）" />

                        <!--  添加示意图  -->
                        <Border
                            Margin="0,15,0,5"
                            Padding="10"
                            BorderBrush="LightGray"
                            BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧：原始图像  -->
                                <StackPanel Grid.Column="0" Margin="5">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="原始图像" />
                                    <Grid>
                                        <Rectangle
                                            Width="150"
                                            Height="150"
                                            Fill="LightGray" />
                                        <Rectangle
                                            Width="100"
                                            Height="70"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Fill="LightBlue" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="图像" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontStyle="Italic"
                                        TextWrapping="Wrap">
                                        图像尺寸：100x70，容器尺寸：150x150
                                    </TextBlock>
                                </StackPanel>

                                <!--  右侧：不同Stretch效果  -->
                                <StackPanel Grid.Column="1" Margin="5">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="四种Stretch模式效果对比" />

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  None  -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="5">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="None" />
                                            <Grid Width="70" Height="70">
                                                <Rectangle
                                                    Width="70"
                                                    Height="70"
                                                    Fill="LightGray" />
                                                <Rectangle
                                                    Width="50"
                                                    Height="35"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="LightBlue" />
                                            </Grid>
                                        </StackPanel>

                                        <!--  Fill  -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="Fill" />
                                            <Grid Width="70" Height="70">
                                                <Rectangle
                                                    Width="70"
                                                    Height="70"
                                                    Fill="LightGray" />
                                                <Rectangle
                                                    Width="70"
                                                    Height="70"
                                                    Fill="LightBlue" />
                                            </Grid>
                                        </StackPanel>

                                        <!--  Uniform  -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="5,10,5,5">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="Uniform" />
                                            <Grid Width="70" Height="70">
                                                <Rectangle
                                                    Width="70"
                                                    Height="70"
                                                    Fill="LightGray" />
                                                <Rectangle
                                                    Width="70"
                                                    Height="49"
                                                    Fill="LightBlue" />
                                            </Grid>
                                        </StackPanel>

                                        <!--  UniformToFill  -->
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="5,10,5,5">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="UniformToFill" />
                                            <Grid Width="70" Height="70">
                                                <Rectangle
                                                    Width="70"
                                                    Height="70"
                                                    Fill="LightGray" />
                                                <Rectangle
                                                    Width="100"
                                                    Height="70"
                                                    ClipToBounds="True"
                                                    Fill="LightBlue" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!--  演示区域  -->
                <GroupBox Margin="0,0,0,20" Header="Stretch属性对比">
                    <Grid Margin="10">
                        <!--  创建一个2x2的网格来展示四种Stretch模式  -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  标题行  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="None" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="Fill" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="Uniform" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="UniformToFill" />

                            <!--  图像行 - 边框区域比例相同  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="120"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image x:Name="imgNone" Stretch="None" />
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="120"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image x:Name="imgFill" Stretch="Fill" />
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="120"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image x:Name="imgUniform" Stretch="Uniform" />
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="3"
                                Width="120"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image x:Name="imgUniformToFill" Stretch="UniformToFill" />
                            </Border>

                            <!--  图像行2 - 横向矩形边框  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,20,0,5"
                                FontWeight="SemiBold"
                                Text="横向矩形边框 (200x80)" />

                            <!--  横向矩形边框说明  -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,0,0,10"
                                Text="这部分展示在宽大于高的容器中，四种不同Stretch模式下同一图像的表现对比。"
                                TextWrapping="Wrap" />

                            <Border
                                Grid.Row="4"
                                Grid.Column="0"
                                Width="200"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="imgNoneWide" Stretch="None" />
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock
                                            Padding="3"
                                            HorizontalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="None" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="4"
                                Grid.Column="1"
                                Width="200"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="imgFillWide" Stretch="Fill" />
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock
                                            Padding="3"
                                            HorizontalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="Fill" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="4"
                                Grid.Column="2"
                                Width="200"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="imgUniformWide" Stretch="Uniform" />
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock
                                            Padding="3"
                                            HorizontalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="Uniform" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="4"
                                Grid.Column="3"
                                Width="200"
                                Height="80"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="imgUniformToFillWide" Stretch="UniformToFill" />
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock
                                            Padding="3"
                                            HorizontalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="UniformToFill" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  添加详细解释行  -->
                            <StackPanel
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="5,10,5,0">
                                <TextBlock FontWeight="SemiBold" Text="特点:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    保持图像的原始像素尺寸，不进行任何拉伸或缩放。如果图像比容器大，部分内容会被裁剪；如果图像比容器小，会有空白区域。
                                </TextBlock>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="适用场景:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    需要按原始尺寸显示图像，如图标、精确像素的UI元素等。
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="5,10,5,0">
                                <TextBlock FontWeight="SemiBold" Text="特点:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    将图像拉伸或缩小以完全填充容器，无论原始比例如何。可能导致图像变形（宽高比失真）。
                                </TextBlock>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="适用场景:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    需要图像完全填充指定区域，且不关心图像比例，如某些背景图案、纹理等。
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="5"
                                Grid.Column="2"
                                Margin="5,10,5,0">
                                <TextBlock FontWeight="SemiBold" Text="特点:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    等比例缩放图像，确保整个图像可见，同时保持原始宽高比。如果容器和图像比例不同，会有空白区域。
                                </TextBlock>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="适用场景:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    需要显示完整图像且保持原始比例，如照片、图表等。这是最常用的设置。
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="5"
                                Grid.Column="3"
                                Margin="5,10,5,0">
                                <TextBlock FontWeight="SemiBold" Text="特点:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    等比例缩放图像以填满整个容器，保持原始宽高比，但可能会裁剪掉部分图像内容。
                                </TextBlock>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="适用场景:" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    需要填满容器且保持图像比例，允许裁剪部分内容，如照片墙、封面图像等。
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!--  StretchDirection属性  -->
                <GroupBox Margin="0,0,0,20" Header="StretchDirection属性">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            TextWrapping="Wrap">
                            StretchDirection属性控制图像的拉伸方向，可以选择Both（可放大或缩小）、UpOnly（只放大）或DownOnly（只缩小）。
                        </TextBlock>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  标题行  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="Both" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="UpOnly" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="DownOnly" />

                            <!--  图像行  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="150"
                                Height="100"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image
                                    x:Name="imgBoth"
                                    Stretch="Uniform"
                                    StretchDirection="Both" />
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="150"
                                Height="100"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image
                                    x:Name="imgUpOnly"
                                    Stretch="Uniform"
                                    StretchDirection="UpOnly" />
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="150"
                                Height="100"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image
                                    x:Name="imgDownOnly"
                                    Stretch="Uniform"
                                    StretchDirection="DownOnly" />
                            </Border>

                            <!--  解释行  -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="5,10,5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">Both</Run>
                                    ：允许图像根据需要放大或缩小。这是默认设置，图像会按照Stretch属性指定的方式调整大小。</TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5,10,5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">UpOnly</Run>
                                    ：只允许图像放大，不允许缩小。如果图像本身就比容器大，则表现与None相同。</TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="5,10,5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">DownOnly</Run>
                                    ：只允许图像缩小，不允许放大。如果图像本身就比容器小，则表现与None相同。</TextBlock>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            TextWrapping="Wrap">
                            注：StretchDirection的效果取决于图像的原始大小与容器大小的关系。如果图像已经比容器大，则UpOnly不会产生效果；如果图像比容器小，则DownOnly不会产生效果。
                        </TextBlock>
                    </Grid>
                </GroupBox>

                <!--  组合使用  -->
                <GroupBox Margin="0,0,0,20" Header="组合使用">
                    <StackPanel Margin="10">
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            结合Stretch属性和对齐方式可以实现更灵活的布局控制。
                        </TextBlock>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  左对齐  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                Text="左对齐" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="180"
                                Height="120"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image
                                    x:Name="imgLeft"
                                    HorizontalAlignment="Left"
                                    Stretch="Uniform" />
                            </Border>

                            <!--  居中  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                Text="居中" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="180"
                                Height="120"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image
                                    x:Name="imgCenter"
                                    HorizontalAlignment="Center"
                                    Stretch="Uniform" />
                            </Border>

                            <!--  右对齐  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                Text="右对齐" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="180"
                                Height="120"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Image
                                    x:Name="imgRight"
                                    HorizontalAlignment="Right"
                                    Stretch="Uniform" />
                            </Border>

                            <!--  对齐解释  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,15,0,0"
                                TextWrapping="Wrap">
                                <Run FontWeight="SemiBold">组合使用说明：</Run>
                                Stretch属性与对齐属性（HorizontalAlignment、VerticalAlignment）结合使用时，
                                可以实现更灵活的布局控制。当使用Uniform或None等可能产生空白区域的Stretch模式时，对齐属性决定了图像在容器中的位置。
                                左对齐、居中和右对齐分别控制图像在水平方向的位置，类似地，可以使用VerticalAlignment控制垂直方向的对齐方式。</TextBlock>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 