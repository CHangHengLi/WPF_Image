<Page x:Class="WPF_Image.Pages.StretchDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Image.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="Stretch属性演示">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Text="Stretch属性演示" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Stretch属性说明 -->
                <GroupBox Header="Stretch属性说明" Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            Stretch属性决定了图像如何适应其容器空间。WPF提供了四种不同的拉伸方式，分别是None、Fill、Uniform和UniformToFill。
                        </TextBlock>
                        
                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,5">Stretch属性可选值:</TextBlock>
                        <TextBlock Text="• None: 保持原始尺寸" Margin="20,0,0,5"/>
                        <TextBlock Text="• Fill: 拉伸以填充整个空间（可能导致图像变形）" Margin="20,0,0,5"/>
                        <TextBlock Text="• Uniform: 等比例拉伸，确保整个图像可见（可能有空白）" Margin="20,0,0,5"/>
                        <TextBlock Text="• UniformToFill: 等比例拉伸，填满空间（可能裁剪部分图像）" Margin="20,0,0,5"/>
                        
                        <!-- 添加示意图 -->
                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,15,0,5" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 左侧：原始图像 -->
                                <StackPanel Grid.Column="0" Margin="5">
                                    <TextBlock Text="原始图像" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Rectangle Fill="LightGray" Width="150" Height="150"/>
                                        <Rectangle Fill="LightBlue" Width="100" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="图像" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontStyle="Italic">
                                        图像尺寸：100x70，容器尺寸：150x150
                                    </TextBlock>
                                </StackPanel>
                                
                                <!-- 右侧：不同Stretch效果 -->
                                <StackPanel Grid.Column="1" Margin="5">
                                    <TextBlock Text="四种Stretch模式效果对比" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- None -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                            <TextBlock Text="None" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <Grid Width="70" Height="70">
                                                <Rectangle Fill="LightGray" Width="70" Height="70"/>
                                                <Rectangle Fill="LightBlue" Width="50" Height="35" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- Fill -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                                            <TextBlock Text="Fill" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <Grid Width="70" Height="70">
                                                <Rectangle Fill="LightGray" Width="70" Height="70"/>
                                                <Rectangle Fill="LightBlue" Width="70" Height="70"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- Uniform -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,10,5,5">
                                            <TextBlock Text="Uniform" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <Grid Width="70" Height="70">
                                                <Rectangle Fill="LightGray" Width="70" Height="70"/>
                                                <Rectangle Fill="LightBlue" Width="70" Height="49"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- UniformToFill -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,10,5,5">
                                            <TextBlock Text="UniformToFill" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                            <Grid Width="70" Height="70">
                                                <Rectangle Fill="LightGray" Width="70" Height="70"/>
                                                <Rectangle Fill="LightBlue" Width="100" Height="70" ClipToBounds="True"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>
                
                <!-- 演示区域 -->
                <GroupBox Header="Stretch属性对比" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <!-- 创建一个2x2的网格来展示四种Stretch模式 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 标题行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="None" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Fill" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Uniform" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="UniformToFill" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            
                            <!-- 图像行 - 边框区域比例相同 -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" 
                                    Width="120" Height="80" Background="LightGray">
                                <Image x:Name="imgNone" Stretch="None"/>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" 
                                    Width="120" Height="80" Background="LightGray">
                                <Image x:Name="imgFill" Stretch="Fill"/>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" 
                                    Width="120" Height="80" Background="LightGray">
                                <Image x:Name="imgUniform" Stretch="Uniform"/>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" 
                                    Width="120" Height="80" Background="LightGray">
                                <Image x:Name="imgUniformToFill" Stretch="UniformToFill"/>
                            </Border>
                            
                            <!-- 图像行2 - 横向矩形边框 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Text="横向矩形边框 (200x80)" 
                                       FontWeight="SemiBold" Margin="0,20,0,5"/>
                                       
                            <!-- 横向矩形边框说明 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" 
                                       Text="这部分展示在宽大于高的容器中，四种不同Stretch模式下同一图像的表现对比。" 
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            
                            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" 
                                    Width="200" Height="80" Background="LightGray">
                                <Grid>
                                    <Image x:Name="imgNoneWide" Stretch="None"/>
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock Text="None" FontWeight="Bold" HorizontalAlignment="Center" Padding="3"/>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" 
                                    Width="200" Height="80" Background="LightGray">
                                <Grid>
                                    <Image x:Name="imgFillWide" Stretch="Fill"/>
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock Text="Fill" FontWeight="Bold" HorizontalAlignment="Center" Padding="3"/>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <Border Grid.Row="4" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" 
                                    Width="200" Height="80" Background="LightGray">
                                <Grid>
                                    <Image x:Name="imgUniformWide" Stretch="Uniform"/>
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock Text="Uniform" FontWeight="Bold" HorizontalAlignment="Center" Padding="3"/>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <Border Grid.Row="4" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" 
                                    Width="200" Height="80" Background="LightGray">
                                <Grid>
                                    <Image x:Name="imgUniformToFillWide" Stretch="UniformToFill"/>
                                    <Border VerticalAlignment="Bottom" Background="#80FFFFFF">
                                        <TextBlock Text="UniformToFill" FontWeight="Bold" HorizontalAlignment="Center" Padding="3"/>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- 添加详细解释行 -->
                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="5,10,5,0">
                                <TextBlock Text="特点:" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    保持图像的原始像素尺寸，不进行任何拉伸或缩放。如果图像比容器大，部分内容会被裁剪；如果图像比容器小，会有空白区域。
                                </TextBlock>
                                <TextBlock Text="适用场景:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    需要按原始尺寸显示图像，如图标、精确像素的UI元素等。
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="5,10,5,0">
                                <TextBlock Text="特点:" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    将图像拉伸或缩小以完全填充容器，无论原始比例如何。可能导致图像变形（宽高比失真）。
                                </TextBlock>
                                <TextBlock Text="适用场景:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    需要图像完全填充指定区域，且不关心图像比例，如某些背景图案、纹理等。
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="5,10,5,0">
                                <TextBlock Text="特点:" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    等比例缩放图像，确保整个图像可见，同时保持原始宽高比。如果容器和图像比例不同，会有空白区域。
                                </TextBlock>
                                <TextBlock Text="适用场景:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    需要显示完整图像且保持原始比例，如照片、图表等。这是最常用的设置。
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="5" Grid.Column="3" Margin="5,10,5,0">
                                <TextBlock Text="特点:" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    等比例缩放图像以填满整个容器，保持原始宽高比，但可能会裁剪掉部分图像内容。
                                </TextBlock>
                                <TextBlock Text="适用场景:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                                    需要填满容器且保持图像比例，允许裁剪部分内容，如照片墙、封面图像等。
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
                
                <!-- StretchDirection属性 -->
                <GroupBox Header="StretchDirection属性" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            StretchDirection属性控制图像的拉伸方向，可以选择Both（可放大或缩小）、UpOnly（只放大）或DownOnly（只缩小）。
                        </TextBlock>
                        
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 标题行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Both" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="UpOnly" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="DownOnly" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            
                            <!-- 图像行 -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" 
                                    Width="150" Height="100" Background="LightGray">
                                <Image x:Name="imgBoth" Stretch="Uniform" StretchDirection="Both"/>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" 
                                    Width="150" Height="100" Background="LightGray">
                                <Image x:Name="imgUpOnly" Stretch="Uniform" StretchDirection="UpOnly"/>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" 
                                    Width="150" Height="100" Background="LightGray">
                                <Image x:Name="imgDownOnly" Stretch="Uniform" StretchDirection="DownOnly"/>
                            </Border>
                            
                            <!-- 解释行 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="5,10,5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">Both</Run>：允许图像根据需要放大或缩小。这是默认设置，图像会按照Stretch属性指定的方式调整大小。
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,10,5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">UpOnly</Run>：只允许图像放大，不允许缩小。如果图像本身就比容器大，则表现与None相同。
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="5,10,5,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">DownOnly</Run>：只允许图像缩小，不允许放大。如果图像本身就比容器小，则表现与None相同。
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap">
                            注：StretchDirection的效果取决于图像的原始大小与容器大小的关系。如果图像已经比容器大，则UpOnly不会产生效果；如果图像比容器小，则DownOnly不会产生效果。
                        </TextBlock>
                    </Grid>
                </GroupBox>
                
                <!-- 组合使用 -->
                <GroupBox Header="组合使用" Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            结合Stretch属性和对齐方式可以实现更灵活的布局控制。
                        </TextBlock>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 左对齐 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="左对齐" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" 
                                    Width="180" Height="120" Background="LightGray">
                                <Image x:Name="imgLeft" Stretch="Uniform" 
                                       HorizontalAlignment="Left"/>
                            </Border>
                            
                            <!-- 居中 -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="居中" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" 
                                    Width="180" Height="120" Background="LightGray">
                                <Image x:Name="imgCenter" Stretch="Uniform" 
                                       HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 右对齐 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="右对齐" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" 
                                    Width="180" Height="120" Background="LightGray">
                                <Image x:Name="imgRight" Stretch="Uniform" 
                                       HorizontalAlignment="Right"/>
                            </Border>
                            
                            <!-- 对齐解释 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,15,0,0">
                                <Run FontWeight="SemiBold">组合使用说明：</Run> Stretch属性与对齐属性（HorizontalAlignment、VerticalAlignment）结合使用时，
                                可以实现更灵活的布局控制。当使用Uniform或None等可能产生空白区域的Stretch模式时，对齐属性决定了图像在容器中的位置。
                                左对齐、居中和右对齐分别控制图像在水平方向的位置，类似地，可以使用VerticalAlignment控制垂直方向的对齐方式。
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 