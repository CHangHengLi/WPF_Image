<Page x:Class="WPF_Image.Pages.EffectsDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Image.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="特效演示">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Text="图像特效与变换演示" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- 图像特效 -->
                <GroupBox Header="图像特效 (Effects)" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            WPF提供了多种图像效果，如模糊、阴影、灰度等。这些效果可以通过在XAML中设置或在代码中动态应用。
                        </TextBlock>
                        
                        <WrapPanel Grid.Row="1">
                            <!-- 原始图像 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="原始图像" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                                    <Image x:Name="imgOriginal" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- 模糊效果 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="模糊效果" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                                    <Image x:Name="imgBlur" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Image.Effect>
                                    </Image>
                                </Border>
                            </StackPanel>
                            
                            <!-- 阴影效果 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="阴影效果" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                                    <Image x:Name="imgShadow" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.Effect>
                                            <DropShadowEffect ShadowDepth="8" BlurRadius="10" Color="Gray"/>
                                        </Image.Effect>
                                    </Image>
                                </Border>
                            </StackPanel>
                            
                            <!-- 灰度效果 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="灰度效果" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                                    <Image x:Name="imgGrayscale" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center"/>
                                </Border>
                                <Button x:Name="btnApplyGrayscale" Content="应用灰度效果" 
                                        Margin="0,5,0,0" Padding="5,3" 
                                        Click="btnApplyGrayscale_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
                
                <!-- 图像变换 -->
                <GroupBox Header="图像变换 (Transforms)" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            变换允许您旋转、缩放、倾斜或移动图像。多个变换可以组合使用。
                        </TextBlock>
                        
                        <WrapPanel Grid.Row="1">
                            <!-- 原始图像 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="原始图像" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                                    <Image x:Name="imgTransformOriginal" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- 旋转变换 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="旋转变换" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Background="LightGray" Margin="0,15,0,0"
                                        Width="180" Height="140" Padding="15">
                                    <Image x:Name="imgRotate" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="45" CenterX="75" CenterY="50"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </StackPanel>
                            
                            <!-- 缩放变换 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="缩放变换" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Background="LightGray" Margin="0,15,0,0"
                                        Width="180" Height="140" Padding="15">
                                    <Image x:Name="imgScale" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="1.5" ScaleY="0.8" CenterX="75" CenterY="50"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </StackPanel>
                            
                            <!-- 组合变换 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="组合变换" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Background="LightGray" Margin="0,15,0,0"
                                        Width="180" Height="140" Padding="15">
                                    <Image x:Name="imgCombined" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="30" CenterX="75" CenterY="50"/>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2" CenterX="75" CenterY="50"/>
                                                <SkewTransform AngleX="10" CenterX="75" CenterY="50"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
                
                <!-- 图像裁剪 -->
                <GroupBox Header="图像裁剪 (Clipping)" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            通过设置Clip属性，可以使用几何图形来裁剪图像，只显示几何图形内部的区域。
                        </TextBlock>
                        
                        <WrapPanel Grid.Row="1">
                            <!-- 原始图像 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="原始图像" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                                    <Image x:Name="imgClipOriginal" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- 矩形裁剪 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="矩形裁剪" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Background="LightGray" Margin="0,15,0,0"
                                        Width="160" Height="110" Padding="5">
                                    <Image x:Name="imgRectClip" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="30,20,90,60"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </StackPanel>
                            
                            <!-- 椭圆裁剪 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="椭圆裁剪" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Background="LightGray" Margin="0,15,0,0"
                                        Width="160" Height="110" Padding="5">
                                    <Image x:Name="imgEllipseClip" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.Clip>
                                            <EllipseGeometry Center="75,50" RadiusX="60" RadiusY="40"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </StackPanel>
                            
                            <!-- 路径裁剪 -->
                            <StackPanel Margin="10">
                                <Border Background="#E0E0E0" Padding="5">
                                    <TextBlock Text="路径裁剪" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Border BorderBrush="Gray" BorderThickness="1" Background="LightGray" Margin="0,15,0,0"
                                        Width="160" Height="110" Padding="5">
                                    <Image x:Name="imgPathClip" Width="150" Height="100" 
                                           Stretch="Uniform" HorizontalAlignment="Center">
                                        <Image.Clip>
                                            <PathGeometry>
                                                <PathFigure StartPoint="75,10">
                                                    <LineSegment Point="110,70"/>
                                                    <LineSegment Point="40,70"/>
                                                    <LineSegment Point="75,10"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
                
                <!-- 动态效果控制 -->
                <GroupBox Header="动态效果控制" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            您可以使用滑块动态调整图像的效果参数。
                        </TextBlock>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Border Background="#E0E0E0" Padding="5" Margin="0,0,10,0">
                                <TextBlock Text="模糊半径:" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Slider x:Name="sliderBlur" Width="200" Minimum="0" Maximum="20" Value="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="sliderBlur_ValueChanged"/>
                            <Border Background="#E0E0E0" Padding="5" Margin="10,0,0,0">
                                <TextBlock x:Name="txtBlurValue" Text="5" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Background="LightGray" 
                                Margin="0,10,0,0" HorizontalAlignment="Center" Padding="10"
                                Width="320" Height="220">
                            <Image x:Name="imgDynamicBlur" Width="300" Height="200" 
                                   Stretch="Uniform" HorizontalAlignment="Center">
                                <Image.Effect>
                                    <BlurEffect Radius="5"/>
                                </Image.Effect>
                            </Image>
                        </Border>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 