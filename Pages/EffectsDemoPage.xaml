<Page
    x:Class="WPF_Image.Pages.EffectsDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_Image.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="特效演示"
    d:DesignHeight="450"
    d:DesignWidth="600"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Margin="0,0,0,20"
            FontSize="20"
            FontWeight="Bold"
            Text="图像特效与变换演示" />

        <!--  主内容  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!--  图像特效  -->
                <GroupBox Margin="0,0,0,20" Header="图像特效 (Effects)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            TextWrapping="Wrap">
                            WPF提供了多种图像效果，如模糊、阴影、灰度等。这些效果可以通过在XAML中设置或在代码中动态应用。
                        </TextBlock>

                        <WrapPanel Grid.Row="1">
                            <!--  原始图像  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="原始图像" />
                                </Border>
                                <Border
                                    Margin="0,15,0,0"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgOriginal"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform" />
                                </Border>
                            </StackPanel>

                            <!--  模糊效果  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="模糊效果" />
                                </Border>
                                <Border
                                    Margin="0,15,0,0"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgBlur"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.Effect>
                                            <BlurEffect Radius="5" />
                                        </Image.Effect>
                                    </Image>
                                </Border>
                            </StackPanel>

                            <!--  阴影效果  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="阴影效果" />
                                </Border>
                                <Border
                                    Margin="0,15,0,0"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgShadow"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                ShadowDepth="8"
                                                Color="Gray" />
                                        </Image.Effect>
                                    </Image>
                                </Border>
                            </StackPanel>

                            <!--  灰度效果  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="灰度效果" />
                                </Border>
                                <Border
                                    Margin="0,15,0,0"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgGrayscale"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform" />
                                </Border>
                                <Button
                                    x:Name="btnApplyGrayscale"
                                    Margin="0,5,0,0"
                                    Padding="5,3"
                                    Click="btnApplyGrayscale_Click"
                                    Content="应用灰度效果" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </GroupBox>

                <!--  图像变换  -->
                <GroupBox Margin="0,0,0,20" Header="图像变换 (Transforms)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            TextWrapping="Wrap">
                            变换允许您旋转、缩放、倾斜或移动图像。多个变换可以组合使用。
                        </TextBlock>

                        <WrapPanel Grid.Row="1">
                            <!--  原始图像  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="原始图像" />
                                </Border>
                                <Border
                                    Margin="0,15,0,0"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgTransformOriginal"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform" />
                                </Border>
                            </StackPanel>

                            <!--  旋转变换  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="旋转变换" />
                                </Border>
                                <Border
                                    Width="180"
                                    Height="140"
                                    Margin="0,15,0,0"
                                    Padding="15"
                                    Background="LightGray"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgRotate"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="45" CenterX="75" CenterY="50" />
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </StackPanel>

                            <!--  缩放变换  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="缩放变换" />
                                </Border>
                                <Border
                                    Width="180"
                                    Height="140"
                                    Margin="0,15,0,0"
                                    Padding="15"
                                    Background="LightGray"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgScale"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <ScaleTransform CenterX="75" CenterY="50" ScaleX="1.5" ScaleY="0.8" />
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </StackPanel>

                            <!--  组合变换  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="组合变换" />
                                </Border>
                                <Border
                                    Width="180"
                                    Height="140"
                                    Margin="0,15,0,0"
                                    Padding="15"
                                    Background="LightGray"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgCombined"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="30" CenterX="75" CenterY="50" />
                                                <ScaleTransform CenterX="75" CenterY="50" ScaleX="1.2" ScaleY="1.2" />
                                                <SkewTransform AngleX="10" CenterX="75" CenterY="50" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </GroupBox>

                <!--  图像裁剪  -->
                <GroupBox Margin="0,0,0,20" Header="图像裁剪 (Clipping)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            TextWrapping="Wrap">
                            通过设置Clip属性，可以使用几何图形来裁剪图像，只显示几何图形内部的区域。
                        </TextBlock>

                        <WrapPanel Grid.Row="1">
                            <!--  原始图像  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="原始图像" />
                                </Border>
                                <Border
                                    Margin="0,15,0,0"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgClipOriginal"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform" />
                                </Border>
                            </StackPanel>

                            <!--  矩形裁剪  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="矩形裁剪" />
                                </Border>
                                <Border
                                    Width="160"
                                    Height="110"
                                    Margin="0,15,0,0"
                                    Padding="5"
                                    Background="LightGray"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgRectClip"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="30,20,90,60" />
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </StackPanel>

                            <!--  椭圆裁剪  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="椭圆裁剪" />
                                </Border>
                                <Border
                                    Width="160"
                                    Height="110"
                                    Margin="0,15,0,0"
                                    Padding="5"
                                    Background="LightGray"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgEllipseClip"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.Clip>
                                            <EllipseGeometry
                                                Center="75,50"
                                                RadiusX="60"
                                                RadiusY="40" />
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </StackPanel>

                            <!--  路径裁剪  -->
                            <StackPanel Margin="10">
                                <Border Padding="5" Background="#E0E0E0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="路径裁剪" />
                                </Border>
                                <Border
                                    Width="160"
                                    Height="110"
                                    Margin="0,15,0,0"
                                    Padding="5"
                                    Background="LightGray"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image
                                        x:Name="imgPathClip"
                                        Width="150"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform">
                                        <Image.Clip>
                                            <PathGeometry>
                                                <PathFigure StartPoint="75,10">
                                                    <LineSegment Point="110,70" />
                                                    <LineSegment Point="40,70" />
                                                    <LineSegment Point="75,10" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </GroupBox>

                <!--  动态效果控制  -->
                <GroupBox Margin="0,0,0,20" Header="动态效果控制">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            TextWrapping="Wrap">
                            您可以使用滑块动态调整图像的效果参数。
                        </TextBlock>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Border
                                Margin="0,0,10,0"
                                Padding="5"
                                Background="#E0E0E0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="模糊半径:" />
                            </Border>
                            <Slider
                                x:Name="sliderBlur"
                                Width="200"
                                IsSnapToTickEnabled="True"
                                Maximum="20"
                                Minimum="0"
                                TickFrequency="1"
                                ValueChanged="sliderBlur_ValueChanged"
                                Value="5" />
                            <Border
                                Margin="10,0,0,0"
                                Padding="5"
                                Background="#E0E0E0">
                                <TextBlock
                                    x:Name="txtBlurValue"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="5" />
                            </Border>
                        </StackPanel>

                        <Border
                            Grid.Row="2"
                            Width="320"
                            Height="220"
                            Margin="0,10,0,0"
                            Padding="10"
                            HorizontalAlignment="Center"
                            Background="LightGray"
                            BorderBrush="Gray"
                            BorderThickness="1">
                            <Image
                                x:Name="imgDynamicBlur"
                                Width="300"
                                Height="200"
                                HorizontalAlignment="Center"
                                Stretch="Uniform">
                                <Image.Effect>
                                    <BlurEffect Radius="5" />
                                </Image.Effect>
                            </Image>
                        </Border>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 