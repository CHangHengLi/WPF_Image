<Page x:Class="WPF_Image.Pages.LoadingDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Image.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="加载方式演示">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Text="图像加载方式演示" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- 本地文件加载 -->
                <GroupBox Header="从本地文件加载" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            从本地文件加载图像是最基本的方式。通过BitmapImage的BeginInit/EndInit方法可以设置更多选项。
                        </TextBlock>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnLoadLocal" Content="加载本地图像" Padding="10,5" Click="btnLoadLocal_Click"/>
                            <TextBlock x:Name="txtLocalStatus" Margin="10,5,0,0"/>
                        </StackPanel>
                        
                        <Image Grid.Row="2" x:Name="imgLocal" Width="300" Height="200" 
                               Stretch="Uniform" HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>
                
                <!-- 异步加载 -->
                <GroupBox Header="异步加载图像" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            异步加载可以避免加载大图像时阻塞UI线程。通过Task.Run将IO操作移至后台线程，并使用Freeze()使图像可以跨线程访问。
                        </TextBlock>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnLoadAsync" Content="异步加载图像" Padding="10,5" Click="btnLoadAsync_Click"/>
                            <ProgressBar x:Name="progressAsync" Width="150" Height="20" Margin="10,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtAsyncStatus" Margin="10,5,0,0"/>
                        </StackPanel>
                        
                        <Image Grid.Row="2" x:Name="imgAsync" Width="300" Height="200" 
                               Stretch="Uniform" HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>
                
                <!-- 性能优化 -->
                <GroupBox Header="图像性能优化" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            通过设置DecodePixelWidth/Height可以在图像解码时控制大小，从而减少内存使用。
                            CacheOption设置为OnLoad可以在图像加载完成后立即关闭文件流。
                        </TextBlock>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnLoadOriginal" Content="加载原始大小" Padding="10,5" Click="btnLoadOriginal_Click"/>
                            <Button x:Name="btnLoadOptimized" Content="加载优化大小" Padding="10,5" Margin="10,0,0,0" Click="btnLoadOptimized_Click"/>
                            <TextBlock x:Name="txtMemoryUsage" Margin="10,5,0,0"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="2" Text="原始图像 vs 优化解码图像（相同显示大小）:" Margin="0,10,0,5"/>
                        
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="原始大小加载" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Image x:Name="imgOriginal" Width="250" Height="150" 
                                       Stretch="Uniform" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="优化大小加载" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Image x:Name="imgOptimized" Width="250" Height="150" 
                                       Stretch="Uniform" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
                
                <!-- 从流加载 -->
                <GroupBox Header="从流加载图像" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                            通过Stream加载图像对于从数据库、网络或内存中获取图像数据非常有用。
                        </TextBlock>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnLoadFromStream" Content="从流加载图像" Padding="10,5" Click="btnLoadFromStream_Click"/>
                            <TextBlock x:Name="txtStreamStatus" Margin="10,5,0,0"/>
                        </StackPanel>
                        
                        <Image Grid.Row="2" x:Name="imgStream" Width="300" Height="200" 
                               Stretch="Uniform" HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 