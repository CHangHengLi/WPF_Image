<Window x:Class="WPF_Image.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Image"
        mc:Ignorable="d"
        Title="WPF Image控件演示" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <TextBlock Grid.Row="0" Text="WPF Image控件演示" 
                   FontSize="24" FontWeight="Bold" Margin="20,15" 
                   HorizontalAlignment="Center"/>

        <!-- 主要内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧菜单 -->
            <StackPanel Grid.Column="0" Width="200" Margin="0,0,20,0">
                <TextBlock Text="功能演示" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button x:Name="btnBasicDemo" Content="基本属性演示" Margin="0,5" Padding="10,5" Click="btnBasicDemo_Click"/>
                <Button x:Name="btnStretchDemo" Content="Stretch属性演示" Margin="0,5" Padding="10,5" Click="btnStretchDemo_Click"/>
                <Button x:Name="btnEffectsDemo" Content="特效和变换演示" Margin="0,5" Padding="10,5" Click="btnEffectsDemo_Click"/>
                <Button x:Name="btnLoadingDemo" Content="加载方式演示" Margin="0,5" Padding="10,5" Click="btnLoadingDemo_Click"/>
                
                <TextBlock Text="说明" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                <TextBlock Text="本程序演示了WPF中Image控件的基本用法和功能特性。请点击左侧按钮查看不同的演示内容。" 
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- 右侧内容 -->
            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="20">
                <Grid x:Name="contentArea">
                    <!-- 默认显示 -->
                    <StackPanel>
                        <TextBlock Text="欢迎使用WPF Image控件演示程序" 
                                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="请点击左侧菜单查看不同的演示内容" 
                                   FontSize="16" Margin="0,0,0,20"/>
                        
                        <Image x:Name="welcomeImage" Width="300" Height="200" 
                               Stretch="Uniform" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Height="25">
            <TextBlock x:Name="statusText" Text="就绪"/>
        </StatusBar>
    </Grid>
</Window>